run = "cd backend && python manage.py runserver 0.0.0.0:5000"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "cd /home/runner/workspace/backend && export DJANGO_SETTINGS_MODULE=djproject.settings && export DJANGO_DEBUG=1 && export DJANGO_ALLOWED_HOSTS='*' && export PYTHONPATH=/home/runner/workspace/backend:/home/runner/workspace/.pythonlibs/lib/python3.12/site-packages && python -m gunicorn djproject.wsgi:application --bind 0.0.0.0:5000 --access-logfile - --error-logfile -"]
