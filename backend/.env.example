# Database Configuration
DATABASE_TYPE=mongodb
MONGODB_URI=mongodb://localhost:27017/studypro_db
DJANGO_DEBUG=1

# Node.js Backend Configuration
NODE_ENV=development
PORT=5000

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# ========================================
# Email Configuration (Gmail Setup)
# ========================================
# IMPORTANT: Setup Instructions for Gmail
# 
# 1. Go to: https://myaccount.google.com/apppasswords
# 2. Select App: Mail, Device: Windows Computer (or other)
# 3. Copy the 16-character app-specific password
# 4. Paste it below as EMAIL_PASSWORD (remove spaces)
# 5. Make sure 2-Step Verification is enabled on your account
#
# EMAIL_SERVICE options: gmail, outlook, yahoo, or other SMTP provider
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=noreply@studyhub.com

# Socket.io Configuration
SOCKET_IO_CORS=http://localhost:3000

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379

# API Configuration
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Transaction Validation
TRANSACTION_TIMEOUT=300000
